# Bearer token required by both the REST API and the MCP endpoint.
MAIL_MCP_API_TOKEN=changeme

# Port the service listens on (binds to 127.0.0.1 only).
MAIL_MCP_PORT=4900

# One password env var per mailbox defined in config/accounts.json,
# named MAILMCP_PASS_<ID UPPERCASED>.
# Example for an account with "id": "example":
MAILMCP_PASS_EXAMPLE=changeme
